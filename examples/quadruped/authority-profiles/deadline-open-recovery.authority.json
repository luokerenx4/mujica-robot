        "recovery.impulse",
        "recovery.capture"
      ]
    },
    "requiredTelemetry": {
      "dynamicRecovery": true
    },
    "minimumTelemetry": {
      "measuredDelaySteps": 1,
      "bodyTiltRad": 0.3
    },
    "maximumTelemetry": {
      "measuredDelaySteps": 1,
      "recoveryRetryCount": 1,
      "baseHeightM": 0.45,
      "supportFeet": 3,
      "modeDwellSeconds": 4.5
    },
    "rampSeconds": 0,
    "entryRampSeconds": 0.4
  }
