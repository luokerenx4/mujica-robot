{
  "version": 1,
  "id": "waist-actuator-contact-history",
  "name": "Four-step actuator and foot-contact history for the fourteen-action waist design",
  "type": "bounded-control-contact-history",
  "fragment": "model.xml",
  "compatibleMounts": ["sensor-bus"],
  "providesMounts": [],
  "observations": [
    { "name": "command-action-history", "kind": "sensor", "size": 56, "source": "control:command-history-4-stable", "unit": "nm" },
    { "name": "applied-action-history", "kind": "sensor", "size": 56, "source": "control:applied-history-4-stable", "unit": "nm" },
    { "name": "foot-contact-history", "kind": "sensor", "size": 16, "source": "sensor-list-history-4:foot-force-fl,foot-force-fr,foot-force-rl,foot-force-rr", "unit": "n" },
    { "name": "actuator-delay-steps", "kind": "sensor", "size": 1, "source": "control:actuator-delay-steps", "unit": "control-step" }
  ],
  "actions": [],
  "dependencies": [],
  "configSchema": { "type": "object", "properties": {}, "additionalProperties": false },
  "physical": { "centerOfMassM": [0, 0, 0], "inertiaDiagonalKgM2": [0, 0, 0] },
  "geometry": [],
  "joints": [],
  "actuators": [],
  "sensors": [
    { "name": "command-action-history", "kind": "actuator-command-history", "source": "runtime" },
    { "name": "applied-action-history", "kind": "actuator-applied-history", "source": "runtime" },
    { "name": "foot-contact-history", "kind": "foot-contact-history", "source": "runtime" },
    { "name": "actuator-delay-steps", "kind": "actuator-delay", "source": "runtime" }
  ],
  "massKg": 0,
  "cost": 1,
  "license": "Apache-2.0",
  "attribution": "Runtime-provided bounded actuator and contact history for the articulated design"
}
