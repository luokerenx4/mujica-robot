    "assumptions": [
      {
        "id": "kinematic-dimensions",
        "status": "sourced",
        "statement": "Hip locations and the 160 mm upper/lower link lengths follow the inspected Solo12 Xacro dimensions.",
        "sourceIds": [
          "odri-solo12-model"
        ],
        "validation": "Compile the MJCF and compare authored joint/site transforms against the source dimensions."
      },
      {
        "id": "mass-properties",
        "status": "derived",
        "statement": "Body and link masses and diagonal inertias are transcribed from the Solo12 Xacro; small off-diagonal inertia terms are omitted in this first clean-room model.",
        "sourceIds": [
          "odri-solo12-model"
        ],
        "validation": "Compare aggregate mass and principal inertias, then replace the approximation only if dynamic sensitivity warrants it."
      },
      {
        "id": "actuator-envelope",
        "status": "sourced",
        "statement": "The 2.5 Nm action envelope follows the ODRI actuator module's documented 12 A output.",
        "sourceIds": [
          "odri-solo12-hardware"
        ],
        "validation": "Keep the Runtime action clip at 2.5 Nm and test standing authority before changing the limit."
      },
      {
        "id": "conservative-joint-envelope",
        "status": "derived",
        "statement": "HAA is conservatively bounded inside the documented 215-degree standard range; HFE and KFE are limited to one bounded working revolution despite the hardware's multi-rotation capability and cable constraint.",
        "sourceIds": [
          "odri-solo12-hardware",
          "odri-solo12-model"
        ],
        "validation": "Static studies must report joint margin in every required pose; hardware cable routing must be reviewed before widening limits."
      },
      {
        "id": "primitive-collision-envelope",
        "status": "hypothesis",
        "statement": "Primitive torso, actuator-pod, link, and foot collision shapes conservatively represent the open hardware without copying its meshes.",
        "sourceIds": [],
        "validation": "Human visual review plus collision-free standing/fall Design Studies; later compare selected clearances against licensed CAD if exact assets are intentionally imported."
      },
      {
        "id": "self-righting-feasibility",
        "status": "hypothesis",
        "statement": "A realistic 12-DoF architecture offers a more credible recovery mechanism than the demo fixture, but no self-righting capability is assumed.",
        "sourceIds": [],
        "validation": "Run identical static and readable-controller probes from left, right, front, and back resting poses."
      }
    ]
  },
