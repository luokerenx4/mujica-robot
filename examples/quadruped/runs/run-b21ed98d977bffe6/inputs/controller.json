    "kdSagittal": 0.2,
    "maximumTorqueNm": 2.5,
    "frequencyHz": 1,
    "dutyFactor": 0.75,
    "nominalForwardSpeedMps": 0.12,
    "nominalLateralSpeedMps": 0.06,
    "nominalYawRateRadPerSec": 0.25,
    "commandDeadband": 0.01,
