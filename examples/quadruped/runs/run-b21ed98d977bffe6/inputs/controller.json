    "upperLegLengthM": 0.16,
    "lowerLegLengthM": 0.16,
    "hipLateralOffsetM": 0.06045,
    "frontHipLongitudinalOffsetM": -0.0195,
    "rearHipLongitudinalOffsetM": 0.0195,
    "hipAmplitudeRad": 0.11,
    "reverseHipAmplitudeRad": 0.25,
    "kneeLiftRad": 0.26,
    "reverseHipPhaseRad": 1.5707963267948966,
    "lateralHalfStrokeM": 0.0225,
    "lateralFrequencyScale": 1,
    "yawTangentialHalfStrokeM": 0.02,
    "swingClearanceM": 0.03,
    "statePredictionSeconds": 0.002,
    "contactThresholdNewton": 1
