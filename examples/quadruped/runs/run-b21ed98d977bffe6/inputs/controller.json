{
  "version": 1,
  "id": "solo12-command-crawl",
  "name": "Solo12 readable planar-command four-beat crawl",
  "kind": "program",
  "entry": "controller.py",
  "interface": {
    "requiredObservations": [
      {
        "name": "joint-position",
        "size": 12
      },
      {
        "name": "joint-velocity",
        "size": 12
      },
      {
        "name": "base-orientation",
        "size": 4
      },
      {
        "name": "base-velocity",
        "size": 6
      },
      {
        "name": "imu-angular-velocity",
        "size": 3
      },
      {
        "name": "foot-contact-force",
        "size": 4
      },
      {
        "name": "motion-command",
        "size": 3
      }
    ],
    "actionChannels": [
      {
        "name": "joint-torque",
        "size": 12,
        "low": -2.5,
        "high": 2.5
      }
    ]
  },
  "config": {
    "homeTarget": [
      0,
      0.8,
      -1.6,
      0,
      0.8,
      -1.6,
      0,
      -0.8,
      1.6,
      0,
      -0.8,
      1.6
    ],
    "kpAbduction": 6,
    "kpAbductionSpatial": 6,
    "kpSagittal": 6,
    "kdAbduction": 0.3,
    "kdAbductionSpatial": 0.5,
